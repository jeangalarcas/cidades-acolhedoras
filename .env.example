# ═══════════════════════════════════════════════════════
# SGA — Variáveis de Ambiente
# COPIE ESTE ARQUIVO PARA .env E PREENCHA OS VALORES
# NUNCA commite o arquivo .env no Git!
# ═══════════════════════════════════════════════════════

# ── APIs hidrométeorologicas ──────────────────────────
ANA_API_KEY=
CEMADEN_API_KEY=
INMET_TOKEN=

# ── Gov.br (CadÚnico, SUAS) ───────────────────────────
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=

# ── Canais de notificação ─────────────────────────────
# SMS (Twilio ou Zenvia)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Business API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Firebase Cloud Messaging (app mobile push)
FCM_SERVER_KEY=

# E-mail (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=alertas@sga.correaecosocial.com.br

# ── IoT / MQTT (sirenes) ──────────────────────────────
MQTT_BROKER_URL=mqtt://
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Google Earth Engine (Sentinel-2) ─────────────────
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=

# ── Banco de dados (produção) ─────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sga_db
REDIS_URL=redis://localhost:6379

# ── Configuração geral ────────────────────────────────
NODE_ENV=development
PORT=8080
